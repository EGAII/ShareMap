/* The website's event dialog (#modal-body), as a page */
.ev-card { padding: 19.2px 17.6px 20.8px; animation: rise .3s var(--ease) both; }
.ev-head { display: flex; flex-direction: column; align-items: flex-start; gap: 4.8px; margin-bottom: 12px; }
.ev-head .h2 { margin: 0; font-size: 22.4px; letter-spacing: -.4px; }
.ev-meta { display: grid; grid-template-columns: auto 1fr; gap: 7.2px 16px; margin: 16px 0 20px;
           padding: 16px 17.6px; background: var(--bg); border-radius: var(--r-md); }
.ev-meta .dt { color: var(--muted); font-size: 13.6px; padding-top: 1.6px; }
.ev-meta .dd { margin: 0; font-variant-numeric: tabular-nums; min-width: 0; word-break: break-all; }
.place-link { display: inline-flex; align-items: center; gap: 4.8px; font-weight: 500; color: var(--accent); }
.place-link.hover { opacity: .7; }
.guest-form { display: flex; gap: 6.4px; margin-top: 9.6px; }
.guest-form .input { flex: 1; }
.share-note { margin-top: 16px; }
.skeleton.head-sk { height: 40px; width: 60%; }
